{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "miragegrid",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "account_id": "ac575a9b822bea2bed97d0ab73aed238",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "AZIEL_RUNTIME_ORIGIN": "https://aziel-runtime.vibelock.workers.dev",
    "PRODUCT": "miragegrid",
    "WORKER_ROLE": "cap-7-shuffle-app"
  },
  "services": [
    {
      "binding": "AZIEL_RUNTIME",
      "service": "aziel-runtime"
    }
  ]
}
